<Project>
  <PropertyGroup>
    <Version>0.1.4.0</Version>
    <FileVersion>0.1.4.0</FileVersion>
    <TargetFramework>net9.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <Copyright>© 2026 Bartosz Cichecki, Kaguya, and Dr. Skinner</Copyright>
    <Product>Project Legion</Product>
    <AssemblyCompany>Project Legion contributors</AssemblyCompany>
    <Nullable>enable</Nullable>
    <NeutralLanguage>en</NeutralLanguage>
    <NuGetAudit>false</NuGetAudit>
    <BaseOutputPath>$(MSBuildThisFileDirectory)BuildProjectLegion\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)BuildProjectLegion\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <Target Name="RemoveRoslynSatellitesAfterPublish" AfterTargets="Publish">
    <ItemGroup>
      <RoslynSatelliteFiles Include="$(PublishDir)\**\Microsoft.CodeAnalysis*.resources.dll" />
    </ItemGroup>
    <Delete Files="@(RoslynSatelliteFiles)" />
  </Target>
</Project>
