<local:BaseWindow
    x:Class="LenovoLegionToolkit.WPF.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:local="clr-namespace:LenovoLegionToolkit.WPF.Windows"
    xmlns:pages="clr-namespace:LenovoLegionToolkit.WPF.Pages"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.AppName}"
    Width="1250"
    Height="780"
    MinWidth="650"
    MinHeight="600"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}">

    <Grid
        Background="{DynamicResource ProjectLegionBackgroundBrush}"
        TextElement.FontFamily="{DynamicResource ProjectLegionFontFamily}"
        TextElement.FontSize="13"
        TextElement.Foreground="{DynamicResource ProjectLegionTextBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Rectangle
            Grid.RowSpan="7"
            IsHitTestVisible="False">
            <Rectangle.Fill>
                <ImageBrush x:Name="_backgroundImage" />
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect x:Name="_backgroundBlurEffect" Radius="0" KernelType="Gaussian" />
            </Rectangle.Effect>
        </Rectangle>

        <Rectangle
            x:Name="_backgroundDimOverlay"
            Grid.RowSpan="7"
            Fill="{DynamicResource ApplicationBackgroundBrush}"
            IsHitTestVisible="False" />

        <wpfui:TitleBar Grid.Row="0" />

        <Grid Grid.Row="0" Margin="12,0,150,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                Source="{StaticResource ProjectLegionTitlebarEmblem}" IsHitTestVisible="False" AutomationProperties.Name="Project Legion emblem"/>
            <TextBlock Margin="24,0,0,0"
                x:Name="_title"
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FlowDirection="LeftToRight"
                FontSize="12"
                IsHitTestVisible="False"
                Text="{x:Static resources:Resource.AppName}" />

            <custom:Badge
                x:Name="_openLogIndicator"
                Grid.Column="1"
                Height="26"
                Margin="0,0,2,0"
                Padding="8,0,8,0"
                VerticalAlignment="Top"
                Appearance="Caution"
                Content="Log"
                Cursor="Hand"
                Focusable="True"
                KeyDown="OpenLogIndicator_KeyDown"
                MouseLeftButtonDown="OpenLogIndicator_Click"
                MouseRightButtonDown="OpenLogIndicator_Click"
                Visibility="Collapsed" />

        </Grid>

        <Grid
            x:Name="_contentGrid"
            Grid.Row="1"
            Margin="12,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,12,12"
                Background="{DynamicResource ProjectLegionBackgroundBrush}"
                BorderBrush="{DynamicResource ProjectLegionBorderBrush}"
                BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="8,0,8,4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Source="{StaticResource ProjectLegionSidebarEmblem}"
                            AutomationProperties.Name="Project Legion emblem" />
                        <Image x:Name="_brandName" Width="88" Height="28" VerticalAlignment="Center"
                            Stretch="Uniform" HorizontalAlignment="Left" Source="{StaticResource ProjectLegionSidebarWordmark}"
                            AutomationProperties.Name="{x:Static resources:Resource.AppName}"/>
                    </StackPanel>

                    <wpfui:NavigationStore
                        x:Name="_navigationStore"
                        Grid.Row="1"
                        Margin="0"
                        Cursor=""
                        Frame="{Binding ElementName=_rootFrame}"
                        Navigated="NavigationStore_Navigated"
                        IsEnabled="False"
                        SelectedPageIndex="-1"
                        TransitionDuration="0"
                        TransitionType="None">

                        <wpfui:NavigationStore.Items>
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Home}"
                                Icon="Home24"
                                PageTag="dashboard"
                                PageType="{x:Type pages:DashboardPage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Performance}"
                                Icon="Gauge24"
                                PageTag="performance"
                                PageType="{x:Type pages:PerformancePage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Thermals}"
                                Icon="Temperature24"
                                PageTag="thermals"
                                PageType="{x:Type pages:ThermalsPage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Battery}"
                                Icon="BatteryCheckmark24"
                                PageTag="battery"
                                PageType="{x:Type pages:BatteryPage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Graphics}"
                                Icon="DeveloperBoard24"
                                PageTag="graphics"
                                PageType="{x:Type pages:GraphicsPage}" />
                            <custom:NavigationItem
                                x:Name="_keyboardItem"
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Keyboard}"
                                Icon="Keyboard24"
                                PageTag="keyboardBacklight"
                                PageType="{x:Type pages:KeyboardBacklightPage}" />
                            <custom:NavigationItem
                                x:Name="_lampArrayKeyboardItem"
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_KeyboardRgb}"
                                Icon="Keyboard24"
                                PageTag="lampArrayKeyboardBacklight"
                                PageType="{x:Type pages:LampArrayRGBKeyboardPage}" />
                            <custom:NavigationItem
                                Content="Mouse"
                                Icon="Cursor24"
                                PageTag="mouse"
                                PageType="{x:Type pages:MousePage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Automation}"
                                Icon="Flash24"
                                PageTag="automation"
                                PageType="{x:Type pages:AutomationPage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Macro}"
                                Icon="ReceiptPlay24"
                                PageTag="macro"
                                PageType="{x:Type pages:MacroPage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Packages}"
                                Icon="Box24"
                                PageTag="packages"
                                PageType="{x:Type pages:PackagesPage}" />
                        </wpfui:NavigationStore.Items>

                        <wpfui:NavigationStore.Footer>
                            <custom:NavigationItem
                                Content="Updater"
                                Icon="ArrowDownload24"
                                PageTag="updater"
                                PageType="{x:Type pages:UpdaterPage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Settings}"
                                Icon="Settings24"
                                PageTag="settings"
                                PageType="{x:Type pages:SettingsPage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_Donate}"
                                Icon="DocumentText24"
                                PageTag="donate"
                                PageType="{x:Type pages:DonatePage}" />
                            <custom:NavigationItem
                                Content="{x:Static resources:Resource.MainWindow_NavigationItem_About}"
                                Icon="Info24"
                                PageTag="about"
                                PageType="{x:Type pages:AboutPage}" />
                        </wpfui:NavigationStore.Footer>

                    </wpfui:NavigationStore>

                    <custom:Badge
                        x:Name="_deviceInfoIndicator"
                        Grid.Row="2"
                        Height="30"
                        Margin="8,8,8,8"
                        Padding="8,0,8,0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Appearance="Transparent"
                        Cursor="Hand"
                        Focusable="True"
                        KeyDown="DeviceInfoIndicator_KeyDown"
                        MouseLeftButtonDown="DeviceInfoIndicator_Click"
                        MouseRightButtonDown="DeviceInfoIndicator_Click"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Margin="0,0,12,12"
                Background="{DynamicResource ProjectLegionContentBrush}"
                BorderBrush="{DynamicResource ProjectLegionBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Margin="12,8,12,0" Padding="10,8" CornerRadius="3"
                            Background="{DynamicResource ProjectLegionAccentSurfaceBrush}"
                            BorderBrush="{DynamicResource ProjectLegionBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Grid.Column="0" Margin="0,0,10,0" Fill="{DynamicResource ProjectLegionAccentBrush}" />
                            <TextBlock x:Name="_controlAccessStatus" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Text="Read-only. Hardware changes have not been verified on this device."
                                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ProjectLegionTextBrush}" />
                            <Button x:Name="_enableControlsButton" Grid.Column="2" Content="Enable controls"
                                    ToolTip="Enables hardware controls, hotkeys and hardware event listeners for this session. Automatic pipelines, live OSD and HWiNFO require separate explicit activation." Click="EnableControls_Click" />
                        </Grid>
                    </Border>
                    <Frame Name="_rootFrame" Grid.Row="1" Margin="14,10,14,10" />
                    <StackPanel
                        x:Name="_startupPanel"
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <wpfui:ProgressRing
                            Width="22"
                            Height="22"
                            Margin="0,0,0,14"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource ProjectLegionAccentBrush}"
                            IsIndeterminate="True" />
                        <TextBlock
                            x:Name="_startupStatusText"
                            Foreground="{DynamicResource ProjectLegionSecondaryTextBrush}"
                            FontSize="13"
                            TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <wpfui:Snackbar
                x:Name="_snackbar"
                Grid.Column="1"
                MinWidth="300"
                HorizontalAlignment="Center"
                Icon="Checkmark24">
                <StackPanel Margin="4,4,4,4" VerticalAlignment="Center">
                    <!--  ReSharper disable once UnusedMember.Global  -->
                    <TextBlock
                        x:Name="_snackbarTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="WrapWithOverflow" />
                    <!--  ReSharper disable once UnusedMember.Global  -->
                    <TextBlock
                        x:Name="_snackbarMessage"
                        Margin="0,6,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="WrapWithOverflow" />
                </StackPanel>
            </wpfui:Snackbar>

        </Grid>

        <Border
            x:Name="_vantageIndicator"
            Grid.Row="2"
            Padding="8,4,8,6"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            Cursor="Hand"
            MouseLeftButtonDown="SoftwareIndicator_MouseLeftButtonDown"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.MainWindow_VantageRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_legionZoneIndicator"
            Grid.Row="3"
            Padding="8,4,8,6"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            Cursor="Hand"
            MouseLeftButtonDown="SoftwareIndicator_MouseLeftButtonDown"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.MainWindow_LegionZoneRunning}" />
            </StackPanel>
        </Border>

        <Border
            x:Name="_legionSpaceIndicator"
            Grid.Row="4"
            Padding="8,4,8,6"
            Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
            Cursor="Hand"
            MouseLeftButtonDown="SoftwareIndicator_MouseLeftButtonDown"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
                <TextBlock
                    Focusable="True"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{x:Static resources:Resource.MainWindow_LegionSpaceRunning}" />
            </StackPanel>
        </Border>

        <Border x:Name="_fnKeysIndicator" Grid.Row="5" Margin="14,0" Padding="0,5"
            Background="Transparent" BorderBrush="{DynamicResource ProjectLegionBorderBrush}" BorderThickness="0,1,0,0"
            Cursor="Hand" MouseLeftButtonDown="SoftwareIndicator_MouseLeftButtonDown" Visibility="Collapsed"
            ToolTip="{x:Static resources:Resource.MainWindow_FnKeysRunning}">
            <DockPanel LastChildFill="True">
                <wpfui:SymbolIcon DockPanel.Dock="Left" Symbol="Warning24" FontSize="12" Margin="0,0,6,0"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                <TextBlock FontSize="11" Foreground="{DynamicResource ProjectLegionSecondaryTextBrush}"
                    Text="{x:Static resources:Resource.MainWindow_FnKeysRunning}" TextWrapping="Wrap" Focusable="True"/>
            </DockPanel>
        </Border>

        <Border
            x:Name="_updateIndicator"
            Grid.Row="6"
            Padding="8,4,8,6"
            Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
            Cursor="Hand"
            MouseLeftButtonDown="UpdateIndicator_Click"
            MouseRightButtonDown="UpdateIndicator_Click"
            Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <wpfui:SymbolIcon
                    Margin="0,0,4,0"
                    Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                    Symbol="ArrowSync24" />
                <TextBlock
                    x:Name="_updateIndicatorText"
                    Focusable="True"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    KeyDown="UpdateIndicator_KeyDown"
                    Text="{x:Static resources:Resource.MainWindow_UpdateAvailable}" />
            </StackPanel>
        </Border>

    </Grid>
</local:BaseWindow>
