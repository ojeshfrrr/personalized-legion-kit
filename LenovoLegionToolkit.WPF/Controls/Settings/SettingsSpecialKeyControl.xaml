<UserControl
    x:Class="LenovoLegionToolkit.WPF.Controls.Settings.SettingsSpecialKeyControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,16,12">
            <TextBlock Style="{StaticResource ProjectLegionSectionTitleStyle}" Text="Special keys" />
            <custom:InfoBar
                x:Name="_fnKeysWarningInfoBar"
                Title="{x:Static resources:Resource.SettingsPage_LenovoHotkeysRunningWarning_Title}"
                Margin="0,0,0,12"
                IsClosable="False"
                IsOpen="False"
                Message="{x:Static resources:Resource.SettingsPage_LenovoHotkeysRunningWarning_Message}"
                Severity="Informational" />

            <custom:CardControl Style="{StaticResource ProjectLegionPreferenceRowStyle}" Margin="0" Icon="Keyboard24">
                <custom:CardControl.Header>
                    <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_SmartFnLock_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_SmartFnLock_Message}" />
                </custom:CardControl.Header>
                <ComboBox
                    x:Name="_smartFnLockComboBox"
                    MinWidth="150"
                    Margin="0"
                    AutomationProperties.Name="{x:Static resources:Resource.SettingsPage_SmartFnLock_Title}"
                    MaxDropDownHeight="Auto"
                    SelectionChanged="SmartFnLockComboBox_SelectionChanged"
                    Visibility="Hidden" />
            </custom:CardControl>
            <custom:CardAction
                x:Name="_excludeRefreshRatesCard"
                Margin="0"
                Click="ExcludeRefreshRates_Click"
                Icon="DesktopPulse24">
                <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_ExcludeRefreshRates_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_ExcludeRefreshRates_Message}" />
            </custom:CardAction>

            <custom:CardAction
                x:Name="_specialKeysCard"
                Margin="0"
                Click="SpecialKeys_Click"
                Icon="Keyboard24">
                <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_SmartKeys_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_SmartKeys_Message}" />
            </custom:CardAction>

            <custom:CardAction
                x:Name="_keyDiscoveryCard"
                Margin="0"
                Click="KeyDiscovery_Click"
                Icon="Search24">
                <controls:CardHeaderControl Title="{x:Static resources:Resource.SettingsPage_Key_Discovery_Title}" Subtitle="{x:Static resources:Resource.SettingsPage_Key_Discovery_Message}" />
            </custom:CardAction>
        </StackPanel>
    </ScrollViewer>
</UserControl>
