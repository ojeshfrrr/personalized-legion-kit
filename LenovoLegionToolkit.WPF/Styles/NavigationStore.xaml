<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Wpf.Ui.Controls;assembly=Wpf.Ui"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:navigation="clr-namespace:Wpf.Ui.Controls.Navigation;assembly=Wpf.Ui">

    <Style x:Key="NavigationStoreItem" TargetType="{x:Type controls:NavigationItem}">
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IconSize" Value="18" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ProjectLegionTextBrush}" />
        <Setter Property="IconForeground" Value="{DynamicResource ProjectLegionSecondaryTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationItem}">
                    <Border
                        x:Name="MainBorder"
                        Padding="6,5"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle
                                x:Name="ActiveMark"
                                Grid.Column="0"
                                Width="3"
                                Height="18"
                                HorizontalAlignment="Left"
                                Fill="{DynamicResource ProjectLegionAccentBrush}"
                                Opacity="0"
                                RadiusX="1.5"
                                RadiusY="1.5" />
                            <controls:SymbolIcon
                                x:Name="ElementIcon"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                FontSize="{TemplateBinding IconSize}"
                                Foreground="{TemplateBinding IconForeground}"
                                Symbol="{TemplateBinding Icon}" />
                            <Image
                                x:Name="ElementImage"
                                Grid.Column="1"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{TemplateBinding Image}" />
                            <TextBlock
                                x:Name="ElementText"
                                Grid.Column="2"
                                Margin="7,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="MainBorder" Property="BorderBrush" Value="{DynamicResource ProjectLegionAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ProjectLegionHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="ActiveMark" Property="Opacity" Value="1" />
                            <Setter TargetName="MainBorder" Property="Background" Value="{DynamicResource ProjectLegionSelectedBrush}" />
                            <Setter TargetName="ElementIcon" Property="Filled" Value="True" />
                            <Setter TargetName="ElementIcon" Property="Foreground" Value="{DynamicResource ProjectLegionAccentBrush}" />
                            <Setter TargetName="ElementText" Property="Foreground" Value="{DynamicResource ProjectLegionAccentBrush}" />
                            <Setter TargetName="ElementText" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="Icon" Value="Empty">
                            <Setter TargetName="ElementIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Image" Value="{x:Null}">
                            <Setter TargetName="ElementImage" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="ElementText" Property="Visibility" Value="Collapsed" />
                            <Setter Property="MinWidth" Value="44" />
                            <Setter Property="MaxWidth" Value="44" />
                            <Setter Property="MinHeight" Value="36" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="MainBorder" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type controls:NavigationStore}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="MaxWidth" Value="160" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NavigationStore}">
                    <controls:DynamicScrollViewer
                        Margin="0"
                        Padding="0"
                        HorizontalScrollBarVisibility="Disabled">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ItemsControl
                                Grid.Row="0"
                                ItemsSource="{TemplateBinding Items}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl
                                Grid.Row="1"
                                ItemsSource="{TemplateBinding Footer}"
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Margin="0" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </controls:DynamicScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style BasedOn="{StaticResource NavigationStoreItem}" TargetType="{x:Type custom:NavigationItem}" />
            <Style BasedOn="{StaticResource NavigationStoreItem}" TargetType="{x:Type controls:NavigationItem}" />
            <Style BasedOn="{StaticResource NavigationStoreHeader}" TargetType="{x:Type navigation:NavigationHeader}" />
        </Style.Resources>
    </Style>
</ResourceDictionary>
