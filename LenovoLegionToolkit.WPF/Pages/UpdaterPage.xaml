<wpfui:UiPage x:Class="LenovoLegionToolkit.WPF.Pages.UpdaterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="clr-namespace:LenovoLegionToolkit.WPF.Controls.Settings"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Updater" Scrollable="True" Loaded="UpdaterPage_Loaded" Unloaded="UpdaterPage_Unloaded">
    <wpfui:UiPage.Resources>
        <Style x:Key="UpdaterPageAction" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ProjectLegionSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource ProjectLegionTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ProjectLegionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ActionBorder" CornerRadius="4" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource ProjectLegionAccentBrush}" />
                                <Setter TargetName="ActionBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource ProjectLegionAccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ActionBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </wpfui:UiPage.Resources>
    <StackPanel Margin="0,0,16,16" MaxWidth="900" HorizontalAlignment="Stretch">
        <TextBlock Text="Updater" Style="{StaticResource ProjectLegionPageTitleStyle}" />
        <TextBlock Text="Check Project Legion versions and download verified updates."
            Style="{StaticResource ProjectLegionPageSubtitleStyle}" />
        <settings:SettingsUpdateControl x:Name="_preferences" CheckCompleted="Preferences_CheckCompleted" />
        <Border Style="{StaticResource ProjectLegionInstrumentPanelStyle}" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="Update status" Style="{StaticResource ProjectLegionSectionTitleStyle}" />
                <TextBlock x:Name="_updateStatus" Text="Check for updates to find a newer version."
                    FontSize="16" TextWrapping="Wrap" Foreground="{DynamicResource ProjectLegionTextBrush}" />
                <TextBlock x:Name="_lastCheck" Style="{StaticResource ProjectLegionNoticeStyle}" />
                <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="_availableUpdateButton" Content="View update &amp; download" Style="{StaticResource UpdaterPageAction}"
                        Click="AvailableUpdate_Click" IsEnabled="False" Margin="0,0,8,8" />
                    <Button x:Name="_releasePageButton" Content="Release history" Style="{StaticResource UpdaterPageAction}"
                        Click="ReleasePage_Click" Margin="0,0,0,8" />
                    <Button x:Name="_rollbackUpdateButton" Content="Roll back to previous version" Style="{StaticResource UpdaterPageAction}"
                        Click="RollbackUpdate_Click" Visibility="Collapsed" Margin="8,0,0,8" />
                </WrapPanel>
                <TextBlock x:Name="_rollbackStatus" Style="{StaticResource ProjectLegionNoticeStyle}" />
                <TextBlock Text="Download opens release notes and a verified ZIP. Install and restart keeps a previous-version backup; manual extraction is also available. Your settings remain in your local profile."
                    Style="{StaticResource ProjectLegionNoticeStyle}" />
            </StackPanel>
        </Border>
    </StackPanel>
</wpfui:UiPage>
