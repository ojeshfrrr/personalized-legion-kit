<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:dashboard="clr-namespace:LenovoLegionToolkit.WPF.Controls.Dashboard"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.DashboardPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Initialized="DashboardPage_Initialized"
    Scrollable="True"
    SizeChanged="DashboardPage_SizeChanged">

    <controls:LoadableControl
        x:Name="_loader"
        Margin="0,0,0,12"
        IndicatorMargin="0,64,0,0">
        <StackPanel x:Name="_panel">
            <Grid Margin="0,8,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                <TextBlock
                    Focusable="True"
                    Style="{StaticResource ProjectLegionPageTitleStyle}"
                    Text="System overview" />
                <TextBlock
                    Style="{StaticResource ProjectLegionPageSubtitleStyle}"
                    Text="Your hardware, at a glance." />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,4,0,12" VerticalAlignment="Center">
                    <TextBlock x:Name="_deviceIdentity" FontSize="14" FontWeight="SemiBold"
                        TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="_deviceType" Margin="0,4,0,0" FontSize="11"
                        Foreground="{DynamicResource ProjectLegionSecondaryTextBrush}"
                        TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <Grid x:Name="_content" />
        </StackPanel>
    </controls:LoadableControl>

</wpfui:UiPage>
