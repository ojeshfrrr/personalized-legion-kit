<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.AboutPage_Title}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Scrollable="True">

    <StackPanel Margin="0,0,16,12">
        <TextBlock
            Focusable="True"
            Style="{StaticResource ProjectLegionPageTitleStyle}"
            Text="{x:Static resources:Resource.AboutPage_Title}" />

        <Image
            Width="240" Height="64" Margin="0,0,0,8"
            HorizontalAlignment="Left" Stretch="Uniform"
            Source="{StaticResource ProjectLegionWordmark}"
            AutomationProperties.Name="{x:Static resources:Resource.AboutPage_AppName}" />
        <TextBlock
            x:Name="_version" Style="{StaticResource ProjectLegionTechnicalTextStyle}"
            Padding="0,0,0,8"
            Focusable="True"
            Text="{x:Static resources:Resource.AboutPage_Version}" />
        <TextBlock
            x:Name="_build" Style="{StaticResource ProjectLegionTechnicalTextStyle}"
            Padding="0,0,0,16"
            Focusable="True"
            Text="{x:Static resources:Resource.AboutPage_Build}" />

        <TextBlock x:Name="_copyright" Focusable="True" />
        <TextBlock
            x:Name="_translationCredit"
            Padding="0,8,0,0"
            Text="{x:Static resources:Resource.AboutPage_TranslationCredit}" />

        <TextBlock
            Padding="0,24,0,8"
            Focusable="True"
            Style="{StaticResource ProjectLegionSectionTitleStyle}"
            Text="{x:Static resources:Resource.AboutPage_Links}" />
        <wpfui:Hyperlink
            Click="Hyperlink_Click"
            Content="Original source project (GPL-3.0)"
            Icon="Link24"
            Tag="https://github.com/LenovoLegionToolkit-Team/LenovoLegionToolkit" />
        <TextBlock Margin="0,8,0,0" Text="Project Legion is an unofficial independent derivative and is not affiliated with or endorsed by Lenovo or the original maintainers." TextWrapping="Wrap" />

        <TextBlock
            Padding="0,24,0,8"
            Focusable="True"
            Style="{StaticResource ProjectLegionSectionTitleStyle}"
            Text="{x:Static resources:Resource.AboutPage_ThirdPartyLibraries}" />

        <WrapPanel Margin="0,0,0,12">
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="AsyncLock" Tag="https://github.com/neosmart/AsyncLock" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Autofac" Tag="https://github.com/autofac/Autofac" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="AvalonEdit" Tag="https://github.com/icsharpcode/AvalonEdit" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Ben.Demystifier" Tag="https://github.com/benaadams/Ben.Demystifier" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="ColorPicker" Tag="https://github.com/PixiEditor/ColorPicker" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="CoordinateSharp" Tag="https://github.com/Tronald/CoordinateSharp" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="CsWin32" Tag="https://github.com/microsoft/CsWin32" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Humanizer" Tag="https://github.com/Humanizr/Humanizer" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="LibreHardwareMonitor" Tag="https://github.com/LenovoLegionToolkit-Team/LibreHardwareMonitor" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="ManagedNativeWifi" Tag="https://github.com/emoacht/ManagedNativeWifi" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Markdig" Tag="https://github.com/xoofx/markdig" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Markdig.Wpf" Tag="https://github.com/Kryptos-FR/markdig.wpf" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="NAudio.Wasapi" Tag="https://github.com/naudio/NAudio" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Newtonsoft.Json" Tag="https://github.com/JamesNK/Newtonsoft.Json" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="NvAPIWrapper" Tag="https://github.com/LenovoLegionToolkit-Team/NvAPIWrapper" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Octokit" Tag="https://github.com/octokit/octokit.net" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="PawnIO" Tag="https://github.com/namazso/PawnIO" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="PresentMonFps" Tag="https://github.com/LenovoLegionToolkit-Team/PresentMonFps" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="PubSub" Tag="https://github.com/upta/pubsub" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="RAMSPDToolkit" Tag="https://github.com/Blacktempel/RAMSPDToolkit" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="Roslyn Scripting" Tag="https://github.com/dotnet/roslyn" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="TaskScheduler" Tag="https://github.com/dahall/TaskScheduler" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="UniversalFanControl.Lib" Tag="https://github.com/LenovoLegionToolkit-Team/UniversalFanControl" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="WindowsDisplayAPI" Tag="https://github.com/LenovoLegionToolkit-Team/WindowsDisplayAPI" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="WPF-UI" Tag="https://github.com/lepoco/wpfui" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="WpfScreenHelper" Tag="https://github.com/micdenny/WpfScreenHelper" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="XamlAnimatedGif" Tag="https://github.com/thomaslevesque/XamlAnimatedGif" />
            <wpfui:Hyperlink Margin="0,0,12,8" Click="Hyperlink_Click" Content="ZenStates-Core" Tag="https://github.com/LenovoLegionToolkit-Team/ZenStates-Core" />
        </WrapPanel>

        <TextBlock
            Padding="0,24,0,8"
            AutomationProperties.Name="{Binding RelativeSource={RelativeSource Mode=Self}, Path=Text}"
            Focusable="True"
            Style="{StaticResource ProjectLegionSectionTitleStyle}"
            Text="{x:Static resources:Resource.AboutPage_ApplicationFolders}" />

        <wpfui:Hyperlink
            Click="OpenApplicationDataFolder_Click"
            Content="{x:Static resources:Resource.AboutPage_Data}"
            Icon="Folder24" />
        <wpfui:Hyperlink
            Click="OpenApplicationTempFolder_Click"
            Content="{x:Static resources:Resource.AboutPage_Temp}"
            Icon="Folder24" />
        <wpfui:Hyperlink
            Click="OpenLogFolder_Click"
            Content="{x:Static resources:Resource.AboutPage_Log}"
            Icon="Folder24" />

    </StackPanel>
</wpfui:UiPage>
