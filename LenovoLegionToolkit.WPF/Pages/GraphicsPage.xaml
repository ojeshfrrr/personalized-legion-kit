<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.GraphicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.MainWindow_NavigationItem_Graphics}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Initialized="GraphicsPage_Initialized"
    Scrollable="True">
    <StackPanel Margin="0,0,12,12">
        <TextBlock
            Focusable="True"
            Style="{StaticResource ProjectLegionPageTitleStyle}"
            Text="{x:Static resources:Resource.MainWindow_NavigationItem_Graphics}" />
        <TextBlock
            Style="{StaticResource ProjectLegionPageSubtitleStyle}"
            Text="GPU routing, activity and device-supported tuning." />
        <Border BorderBrush="{DynamicResource ProjectLegionAccentBrush}" BorderThickness="2,0,0,0" Padding="14,0,0,0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Style="{StaticResource ProjectLegionSectionTitleStyle}" Text="Graphics routing" />
                <StackPanel x:Name="_modeControls" />
                <TextBlock Style="{StaticResource ProjectLegionNoticeStyle}" Text="Available modes are reported by your device. Discrete-only and UMA transitions may require a restart; review the device prompt before applying." />
            </StackPanel>
        </Border>
        <TextBlock Style="{StaticResource ProjectLegionSectionTitleStyle}" Text="GPU activity and tuning" />
        <StackPanel x:Name="_controls" />
        <TextBlock
            x:Name="_errorText"
            Style="{StaticResource ProjectLegionNoticeStyle}"
            Foreground="{DynamicResource SystemFillColorCautionBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <ProgressBar
            x:Name="_loadingIndicator"
            Height="2"
            IsIndeterminate="True"
            Foreground="{DynamicResource ProjectLegionAccentBrush}" />
    </StackPanel>
</wpfui:UiPage>
