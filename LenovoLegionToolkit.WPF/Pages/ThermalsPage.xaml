<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.ThermalsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LenovoLegionToolkit.WPF.Controls"
    xmlns:custom="clr-namespace:LenovoLegionToolkit.WPF.Controls.Custom"
    xmlns:dashboard="clr-namespace:LenovoLegionToolkit.WPF.Controls.Dashboard"
    xmlns:resources="clr-namespace:LenovoLegionToolkit.WPF.Resources"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="{x:Static resources:Resource.MainWindow_NavigationItem_Thermals}"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Initialized="ThermalsPage_Initialized"
    Scrollable="True">
    <StackPanel Margin="0,0,12,12">
        <TextBlock
            Focusable="True"
            Style="{StaticResource ProjectLegionPageTitleStyle}"
            Text="{x:Static resources:Resource.MainWindow_NavigationItem_Thermals}" />
        <TextBlock
            Style="{StaticResource ProjectLegionPageSubtitleStyle}"
            Text="Temperature, load and cooling at a glance." />

        <custom:CardControl Margin="0,0,0,10">
            <custom:CardControl.Header>
                <!-- CardControl gives Header the remaining width and Content an Auto column.
                     Keep wrapping descriptions in Header so they cannot consume that width. -->
                <StackPanel>
                    <controls:CardHeaderControl Title="Cooling controls" Subtitle="Device-supported fan curves and power limits." />
                    <TextBlock
                        x:Name="_fanSettingsStatus"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource ProjectLegionSecondaryTextBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </custom:CardControl.Header>
            <Button
                x:Name="_fanSettingsButton"
                HorizontalAlignment="Left"
                Click="FanSettingsButton_Click"
                Content="Fan settings"
                IsEnabled="False" />
        </custom:CardControl>

        <TextBlock
            x:Name="_sensorsDisabledText"
            Margin="0,4,0,12"
            Foreground="{DynamicResource ProjectLegionSecondaryTextBrush}"
            Text="Advanced hardware sensors are disabled. Available CPU/GPU readings below use Windows, NVAPI and Lenovo queries; unsupported readings appear as a dash."
            TextWrapping="Wrap"
            Visibility="Collapsed" />
        <dashboard:SensorsControl x:Name="_sensorsControl" />
    </StackPanel>
</wpfui:UiPage>
