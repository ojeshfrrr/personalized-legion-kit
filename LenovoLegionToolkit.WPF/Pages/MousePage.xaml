<wpfui:UiPage x:Class="LenovoLegionToolkit.WPF.Pages.MousePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Mouse" FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Loaded="Page_Loaded" Unloaded="Page_Unloaded" Scrollable="True">
    <wpfui:UiPage.Resources>
        <Style x:Key="MouseLabel" TargetType="TextBlock" BasedOn="{StaticResource ProjectLegionNoticeStyle}">
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="MouseSection" TargetType="TextBlock" BasedOn="{StaticResource ProjectLegionSectionTitleStyle}">
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="MouseValidation" TargetType="TextBlock" BasedOn="{StaticResource ProjectLegionNoticeStyle}">
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger></Style.Triggers>
        </Style>
        <Style x:Key="MouseSurface" TargetType="Border" BasedOn="{StaticResource ProjectLegionInstrumentPanelStyle}">
            <Setter Property="Padding" Value="18" /><Setter Property="Background" Value="#090A0C" />
        </Style>
        <Style x:Key="MousePresetInspector" TargetType="Expander">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton x:Name="InspectorHeader" Content="{TemplateBinding Header}" MinHeight="36" Padding="10,6"
                            HorizontalContentAlignment="Left" Foreground="{TemplateBinding Foreground}" Background="#111318"
                            BorderBrush="#252932" BorderThickness="1" Focusable="True"
                            AutomationProperties.Name="Inspect stored local preset and apply result"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter x:Name="InspectorContent" ContentSource="Content" Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True"><Setter TargetName="InspectorContent" Property="Visibility" Value="Visible" /></Trigger>
                        <Trigger SourceName="InspectorHeader" Property="IsKeyboardFocused" Value="True"><Setter TargetName="InspectorHeader" Property="BorderBrush" Value="#FF334F" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <Style x:Key="MouseAssignmentRow" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ProjectLegionTextBrush}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" Padding="{TemplateBinding Padding}" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#15181D" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Row" Property="BorderBrush" Value="#FF334F" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
        <!-- Original vector artwork. Content is the actual hit-tested geometry;
             all regions share the drawing's single Viewbox coordinate system. -->
        <Style x:Key="MouseHotspot" TargetType="RadioButton">
            <Setter Property="Width" Value="320" /><Setter Property="Height" Value="520" />
            <Setter Property="Background" Value="#1A1E24" />
            <Setter Property="BorderBrush" Value="#353B44" />
            <Setter Property="GroupName" Value="MouseSchematic" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template"><Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Path x:Name="Region" Data="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                        Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.2"
                        StrokeLineJoin="Round" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Region" Property="Fill" Value="#29222A" /><Setter TargetName="Region" Property="Stroke" Value="#969CA6" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Region" Property="Fill" Value="#39151E" /><Setter TargetName="Region" Property="Stroke" Value="#FF334F" /><Setter TargetName="Region" Property="StrokeThickness" Value="2" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Region" Property="Stroke" Value="#F4F4F5" /><Setter TargetName="Region" Property="StrokeThickness" Value="2.5" /><Setter TargetName="Region" Property="StrokeDashArray" Value="3,2" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value></Setter>
        </Style>
    </wpfui:UiPage.Resources>
    <StackPanel x:Name="_mouseContent" MaxWidth="1020" HorizontalAlignment="Stretch" Margin="0,0,16,20" SizeChanged="MouseContent_SizeChanged">
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource ProjectLegionPageTitleStyle}" Text="Mouse" />
                <TextBlock Text="DeathAdder V3 wired" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="Razer · USB 1532:00B2" Style="{StaticResource ProjectLegionTechnicalTextStyle}" Margin="0,4,0,0" />
            </StackPanel>
            <wpfui:Button x:Name="_refreshMouseButton" Grid.Column="1" Content="Read device" MinHeight="36" VerticalAlignment="Top"
                Click="Refresh_Click" AutomationProperties.Name="Read mouse DPI and polling configuration" />
        </Grid>
        <TextBlock x:Name="_connectionText" Text="Not queried" Style="{StaticResource ProjectLegionNoticeStyle}" Margin="0,0,0,6" />
        <Border Background="#210B10" BorderBrush="#252932" BorderThickness="1,0,0,0" Padding="10,8" Margin="0,0,0,18">
            <TextBlock x:Name="_permissionText" Text="Settings locked until device access is confirmed."
                Style="{StaticResource ProjectLegionNoticeStyle}" Margin="0" AutomationProperties.LiveSetting="Polite" />
        </Border>
        <Grid x:Name="_primaryGrid" Margin="0,0,0,24">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="_dpiColumn" Width="3*" /><ColumnDefinition x:Name="_pollingColumn" Width="2*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border x:Name="_dpiSurface" Style="{StaticResource MouseSurface}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Sensitivity" Style="{StaticResource MouseSection}" />
                    <TextBlock Text="Confirmed X / Y DPI" Style="{StaticResource MouseLabel}" />
                    <TextBlock x:Name="_currentDpiText" Text="Unavailable" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,0,0,4" />
                    <TextBlock x:Name="_lastDpiText" Text="No confirmed DPI reading yet." Style="{StaticResource ProjectLegionTechnicalTextStyle}" Margin="0,0,0,18" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><Label Content="Requested X" Target="{Binding ElementName=_dpiX}" Padding="0,0,0,6" />
                            <wpfui:TextBox x:Name="_dpiX" MinHeight="36" ClearButtonEnabled="False" IsEnabled="False" TextChanged="Draft_Changed" AutomationProperties.Name="Requested X axis DPI" /></StackPanel>
                        <StackPanel Grid.Column="2"><Label Content="Requested Y" Target="{Binding ElementName=_dpiY}" Padding="0,0,0,6" />
                            <wpfui:TextBox x:Name="_dpiY" MinHeight="36" ClearButtonEnabled="False" IsEnabled="False" TextChanged="Draft_Changed" AutomationProperties.Name="Requested Y axis DPI" /></StackPanel>
                    </Grid>
                    <TextBlock Text="100–30,000 · steps of 50 · active override only" Style="{StaticResource ProjectLegionTechnicalTextStyle}" Margin="0,8,0,10" />
                    <TextBlock x:Name="_dpiValidationText" Style="{StaticResource MouseValidation}" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Margin="0,0,0,8">
                        <wpfui:Button x:Name="_applyButton" Content="Apply DPI" Appearance="Primary" MinHeight="36" Margin="0,0,8,6" IsEnabled="False" Click="Apply_Click" />
                        <wpfui:Button x:Name="_resetButton" Content="Reset inputs" MinHeight="36" Margin="0,0,0,6" IsEnabled="False" Click="Reset_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="_statusText" Style="{StaticResource ProjectLegionNoticeStyle}" AutomationProperties.LiveSetting="Polite" Text="Read the device. Inputs never apply automatically." />
                </StackPanel>
            </Border>
            <Border x:Name="_pollingSurface" Grid.Column="1" Style="{StaticResource MouseSurface}">
                <StackPanel>
                    <TextBlock Text="Polling rate" Style="{StaticResource MouseSection}" />
                    <TextBlock Text="Confirmed configuration" Style="{StaticResource MouseLabel}" />
                    <TextBlock x:Name="_pollingCurrentText" Text="Unavailable" FontSize="26" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular" Margin="0,0,0,4" />
                    <TextBlock x:Name="_lastPollingText" Text="No confirmed polling reading yet." Style="{StaticResource ProjectLegionTechnicalTextStyle}" Margin="0,0,0,18" />
                    <Label Content="Requested rate" Target="{Binding ElementName=_pollingSelector}" Padding="0,0,0,6" />
                    <ComboBox x:Name="_pollingSelector" MinHeight="36" IsEnabled="False" DisplayMemberPath="Label" SelectionChanged="PollingSelection_Changed" AutomationProperties.Name="Requested mouse polling rate" />
                    <TextBlock Text="Configured Hz; physical input frequency is not measured." Style="{StaticResource ProjectLegionTechnicalTextStyle}" Margin="0,8,0,10" />
                    <wpfui:Button x:Name="_pollingApplyButton" Content="Apply rate" MinHeight="36" HorizontalAlignment="Left" Margin="0,0,0,14" IsEnabled="False" Click="ApplyPolling_Click" />
                    <TextBlock x:Name="_pollingStatusText" Style="{StaticResource ProjectLegionNoticeStyle}" AutomationProperties.LiveSetting="Polite" Text="No rate assumed. Read the device first." />
                </StackPanel>
            </Border>
        </Grid>
        <Border Style="{StaticResource MouseSurface}" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Local software presets" Style="{StaticResource MouseSection}" />
                <TextBlock x:Name="_presetPolicy" Text="Stored on this PC only. Selecting a preset never changes the mouse." Style="{StaticResource ProjectLegionNoticeStyle}" Margin="0,0,0,10" />
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <ComboBox x:Name="_presetSelector" MinHeight="36" DisplayMemberPath="Name" SelectionChanged="PresetSelection_Changed" AutomationProperties.Name="Local software preset to inspect" />
                    <wpfui:Button x:Name="_presetReload" Grid.Column="1" Content="Reload" Margin="8,0,0,0" MinHeight="36" Click="PresetReload_Click" />
                </Grid>
                <Label Content="Preset name" Target="{Binding ElementName=_presetName}" Padding="0,0,0,6" />
                <wpfui:TextBox x:Name="_presetName" MinHeight="36" MaxLength="64" ClearButtonEnabled="False" AutomationProperties.Name="Local preset name" />
                <CheckBox x:Name="_presetIncludeAssignments" Content="Include confirmed bank-1 assignments" Margin="0,10,0,10" IsChecked="False" />
                <WrapPanel>
                    <wpfui:Button x:Name="_presetSave" Content="Save confirmed as new" MinHeight="36" Margin="0,0,8,8" Click="PresetSave_Click" />
                    <wpfui:Button x:Name="_presetRename" Content="Rename" MinHeight="36" Margin="0,0,8,8" Click="PresetRename_Click" />
                    <wpfui:Button x:Name="_presetDelete" Content="Delete local" MinHeight="36" Margin="0,0,8,8" Click="PresetDelete_Click" />
                    <wpfui:Button x:Name="_presetApply" Content="Apply preset…" Appearance="Primary" MinHeight="36" Margin="0,0,0,8" Click="PresetApply_Click" />
                </WrapPanel>
                <TextBlock x:Name="_presetStatus" Text="No local preset loaded yet." Style="{StaticResource ProjectLegionNoticeStyle}" AutomationProperties.LiveSetting="Polite" />
                <Expander x:Name="_presetInspector" Style="{StaticResource MousePresetInspector}" Header="Stored settings and apply result" Margin="0,10,0,0" Foreground="{DynamicResource ProjectLegionTextBrush}" Background="Transparent">
                    <StackPanel Margin="0,10,0,0">
                        <TextBlock x:Name="_presetStored" Text="No preset selected." Style="{StaticResource ProjectLegionNoticeStyle}" />
                        <TextBlock x:Name="_presetResult" Text="No preset applied in this page session." Style="{StaticResource ProjectLegionNoticeStyle}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
        <TextBlock Text="Button assignments" Style="{StaticResource MouseSection}" />
        <TextBlock Text="Select a region or an assignment below. Selection never changes the mouse."
            Style="{StaticResource ProjectLegionNoticeStyle}" Margin="0,0,0,12" />
        <WrapPanel Margin="0,0,0,12">
            <wpfui:Button x:Name="_readButtonProfiles" Content="Read banks" MinHeight="36" Margin="0,0,8,8" Click="ReadButtonProfiles_Click" />
            <ComboBox x:Name="_buttonProfileSelector" Width="150" MinHeight="36" Margin="0,0,8,8" DisplayMemberPath="Label" IsEnabled="False" SelectionChanged="ButtonProfile_Changed" AutomationProperties.Name="Device bank to inspect, not activate" />
            <wpfui:Button x:Name="_readButtonAssignments" Content="Read assignments" MinHeight="36" Margin="0,0,0,8" IsEnabled="False" Click="ReadButtonAssignments_Click" />
        </WrapPanel>
        <Grid x:Name="_mappingGrid">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="_schematicColumn" Width="230" /><ColumnDefinition x:Name="_editorColumn" Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel x:Name="_schematicSurface" Margin="0,0,18,0">
                <Viewbox x:Name="_schematicView" Stretch="Uniform" StretchDirection="DownOnly" Height="440" HorizontalAlignment="Center">
                    <Canvas x:Name="_mouseSchematic" Width="320" Height="520" Background="#000000"
                        AutomationProperties.Name="Original wired DeathAdder V3 top-view illustration">
                        <!-- Cable, strain relief and the asymmetric ergonomic shell. -->
                        <Path Data="M 161,70 C 158,48 158,35 171,22 C 182,12 194,12 209,5" Stroke="#262B32" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
                        <Path Data="M 159,66 C 156,47 157,34 170,21 C 181,11 193,11 208,4" Stroke="#454B54" StrokeThickness="1" IsHitTestVisible="False" />
                        <Path Data="M 154,54 L 168,54 L 170,78 L 152,78 Z" Fill="#16191E" Stroke="#30353D" IsHitTestVisible="False" />
                        <!-- Photo-informed silhouette: faceted front shoulders,
                             narrow waist and one continuous, full palm shell. -->
                        <Path Data="M 151,64 L 113,70 L 80,82 Q 67,87 66,111 L 73,217 C 72,246 68,268 69,299 L 72,351 C 75,404 106,435 158,438 C 215,440 253,409 263,361 C 273,317 261,276 255,241 L 244,117 Q 242,88 229,80 L 191,66 L 169,64 Z"
                            Fill="#1B1F25" Stroke="#4B515B" StrokeThickness="1.5" IsHitTestVisible="False" />
                        <Path Data="M 72,237 C 71,275 72,319 78,353 C 83,389 100,412 121,423 C 92,412 78,388 74,355 C 70,315 66,276 72,237 Z"
                            Fill="#11151A" IsHitTestVisible="False" />
                        <Path Data="M 79,271 C 77,313 81,350 90,372 M 243,265 C 251,307 260,343 248,377 M 106,420 C 136,437 176,437 204,425"
                            Stroke="#30363E" StrokeThickness="0.8" IsHitTestVisible="False" />
                        <!-- A fine centre seam, rather than a separate decorative spine. -->
                        <Path Data="M 159,72 L 159,96 M 154,162 L 170,227"
                            Stroke="#080A0D" StrokeThickness="2" IsHitTestVisible="False" />
                        <Path Data="M 151,94 C 145,94 143,99 143,107 L 143,151 C 143,161 149,165 159,165 C 170,165 177,159 177,150 L 176,107 C 176,99 169,94 163,94 Z"
                            Fill="#050607" Stroke="#373E48" IsHitTestVisible="False" />
                        <!-- Each region is a keyboard-focusable radio button, not a bitmap overlay. -->
                        <RadioButton x:Name="_region1" Style="{StaticResource MouseHotspot}" Tag="1" Click="Schematic_Click"
                            ToolTip="Left button · primary click protected" AutomationProperties.Name="Select left button, protected from remapping">
                            <RadioButton.Content><PathGeometry Figures="M 81,84 L 114,74 L 151,67 L 155,94 L 145,97 L 145,161 L 153,164 L 167,225 L 91,235 Q 82,236 81,226 L 70,115 Q 68,92 81,84 Z" /></RadioButton.Content>
                        </RadioButton>
                        <RadioButton x:Name="_region2" Style="{StaticResource MouseHotspot}" Tag="2" Click="Schematic_Click" Background="#171B21"
                            ToolTip="Right button" AutomationProperties.Name="Select right button">
                            <RadioButton.Content><PathGeometry Figures="M 169,67 L 190,69 L 228,83 Q 238,90 240,117 L 249,222 Q 250,231 240,231 L 172,225 L 158,164 L 177,161 L 177,97 L 168,94 Z" /></RadioButton.Content>
                        </RadioButton>
                        <RadioButton x:Name="_region3" Style="{StaticResource MouseHotspot}" Tag="3" Click="Schematic_Click" Background="#272C33"
                            ToolTip="Scroll-wheel click" AutomationProperties.Name="Select scroll-wheel click">
                            <RadioButton.Content><PathGeometry Figures="M 155,99 L 164,99 Q 171,100 171,107 L 172,150 Q 170,159 161,160 L 154,159 Q 148,157 148,149 L 148,108 Q 148,100 155,99 Z" /></RadioButton.Content>
                        </RadioButton>
                        <RadioButton x:Name="_region5" Style="{StaticResource MouseHotspot}" Tag="5" Click="Schematic_Click" Background="#242A32"
                            ToolTip="Front side button · ID 5" AutomationProperties.Name="Select front side button 5">
                            <RadioButton.Content><PathGeometry Figures="M 64,182 Q 70,181 76,186 L 80,207 Q 80,214 73,218 L 59,223 Q 55,220 57,214 L 57,190 Q 58,184 64,182 Z" /></RadioButton.Content>
                        </RadioButton>
                        <RadioButton x:Name="_region4" Style="{StaticResource MouseHotspot}" Tag="4" Click="Schematic_Click" Background="#222830"
                            ToolTip="Rear side button · ID 4" AutomationProperties.Name="Select rear side button 4">
                            <RadioButton.Content><PathGeometry Figures="M 59,233 L 72,228 Q 77,228 77,234 L 71,259 Q 68,265 56,270 Q 50,270 51,263 L 53,242 Q 53,235 59,233 Z" /></RadioButton.Content>
                        </RadioButton>
                        <!-- Non-interactive seams and wheel ribs cannot intercept selection. -->
                        <Path Data="M 89,239 L 168,229 L 241,235 M 152,108 L 167,108 M 151,114 L 168,114 M 151,120 L 168,120 M 151,126 L 168,126 M 151,132 L 168,132 M 151,138 L 168,138 M 151,144 L 168,144 M 152,150 L 167,150"
                            Stroke="#515863" StrokeThickness="1" IsHitTestVisible="False" />
                        <Path Data="M 85,89 L 114,79 L 142,73 M 179,73 L 190,75 L 226,88"
                            Stroke="#414750" StrokeThickness="0.7" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="124" Canvas.Top="353" Text="Wired V3" Foreground="#69727E" FontSize="12" IsHitTestVisible="False" />
                        <!-- Scroll directions share the real wheel. The DPI switch is underneath,
                             so these inspection targets are deliberately outside the top shell. -->
                        <TextBlock Canvas.Left="48" Canvas.Top="451" Text="Wheel" Foreground="#969CA6" FontSize="12" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="183" Canvas.Top="451" Text="Underside" Foreground="#969CA6" FontSize="12" IsHitTestVisible="False" />
                        <RadioButton x:Name="_region9" Style="{StaticResource MouseHotspot}" Tag="9" Click="Schematic_Click"
                            ToolTip="Scroll up" AutomationProperties.Name="Select wheel up">
                            <RadioButton.Content><PathGeometry Figures="M 48,475 Q 48,471 52,471 L 91,471 Q 95,471 95,475 L 95,501 Q 95,505 91,505 L 52,505 Q 48,505 48,501 Z" /></RadioButton.Content>
                        </RadioButton>
                        <RadioButton x:Name="_region10" Style="{StaticResource MouseHotspot}" Tag="10" Click="Schematic_Click"
                            ToolTip="Scroll down" AutomationProperties.Name="Select wheel down">
                            <RadioButton.Content><PathGeometry Figures="M 104,475 Q 104,471 108,471 L 147,471 Q 151,471 151,475 L 151,501 Q 151,505 147,505 L 108,505 Q 104,505 104,501 Z" /></RadioButton.Content>
                        </RadioButton>
                        <RadioButton x:Name="_region96" Style="{StaticResource MouseHotspot}" Tag="96" Click="Schematic_Click"
                            ToolTip="Underside DPI button" AutomationProperties.Name="Select underside DPI button">
                            <RadioButton.Content><PathGeometry Figures="M 178,475 Q 178,471 182,471 L 272,471 Q 276,471 276,475 L 276,501 Q 276,505 272,505 L 182,505 Q 178,505 178,501 Z" /></RadioButton.Content>
                        </RadioButton>
                        <TextBlock Canvas.Left="65" Canvas.Top="476" Text="↑" FontSize="16" Foreground="#F4F4F5" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="121" Canvas.Top="476" Text="↓" FontSize="16" Foreground="#F4F4F5" IsHitTestVisible="False" />
                        <TextBlock Canvas.Left="216" Canvas.Top="479" Text="DPI" FontSize="12" Foreground="#F4F4F5" IsHitTestVisible="False" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Original vector · top view" Style="{StaticResource ProjectLegionTechnicalTextStyle}" HorizontalAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>
            <Border x:Name="_assignmentEditor" Grid.Column="1" Style="{StaticResource MouseSurface}">
                <StackPanel>
                    <TextBlock x:Name="_selectedButtonTitle" Text="Select a button" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <ComboBox x:Name="_buttonTargetSelector" MinHeight="36" DisplayMemberPath="Name" IsEnabled="False" SelectionChanged="ButtonDraft_Changed" AutomationProperties.Name="Mouse button to inspect or remap" Margin="0,0,0,12" />
                    <Border BorderBrush="#252932" BorderThickness="0,0,0,1" Padding="0,0,0,12" Margin="0,0,0,12">
                        <TextBlock x:Name="_buttonConfirmedValue" Text="Last confirmed: unavailable." Style="{StaticResource ProjectLegionNoticeStyle}" />
                    </Border>
                    <TextBlock Text="Assignment category" Style="{StaticResource MouseLabel}" />
                    <ComboBox x:Name="_buttonDraftKind" MinHeight="36" DisplayMemberPath="Label" IsEnabled="False" SelectionChanged="ButtonDraft_Changed" AutomationProperties.Name="Requested assignment type" Margin="0,0,0,8" />
                    <ComboBox x:Name="_buttonActionSelector" MinHeight="36" DisplayMemberPath="Label" IsEnabled="False" SelectionChanged="ButtonDraft_Changed" AutomationProperties.Name="Requested button function" Margin="0,0,0,8" />
                    <StackPanel x:Name="_keyboardAssignmentOptions" IsEnabled="False" Visibility="Collapsed" Margin="0,0,0,12">
                        <Label Content="Key · type a name to select" Target="{Binding ElementName=_buttonKeyboardKey}" Padding="0,0,0,6" />
                        <ComboBox x:Name="_buttonKeyboardKey" MinHeight="36" DisplayMemberPath="Label" IsTextSearchEnabled="True" TextSearch.TextPath="Label" MaxDropDownHeight="240"
                            SelectionChanged="ButtonDraft_Changed" AutomationProperties.Name="Requested keyboard key, type a key name to search" />
                        <TextBlock Text="Modifiers" Style="{StaticResource MouseLabel}" Margin="0,12,0,6" />
                        <WrapPanel>
                            <CheckBox x:Name="_keyLeftCtrl" Content="Left Ctrl" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                            <CheckBox x:Name="_keyLeftShift" Content="Left Shift" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                            <CheckBox x:Name="_keyLeftAlt" Content="Left Alt" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                            <CheckBox x:Name="_keyLeftWin" Content="Left Win" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                        </WrapPanel>
                        <WrapPanel>
                            <CheckBox x:Name="_keyRightCtrl" Content="Right Ctrl" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                            <CheckBox x:Name="_keyRightShift" Content="Right Shift" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                            <CheckBox x:Name="_keyRightAlt" Content="Right Alt" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                            <CheckBox x:Name="_keyRightWin" Content="Right Win" Margin="0,0,12,8" Checked="KeyboardModifier_Changed" Unchecked="KeyboardModifier_Changed" />
                        </WrapPanel>
                        <TextBlock Text="One key plus modifiers. Modifier-only actions, macros and sequences are unavailable. Keyboard writes await a physical test."
                            Style="{StaticResource ProjectLegionTechnicalTextStyle}" />
                    </StackPanel>
                    <TextBlock x:Name="_buttonRequestedValue" Text="Requested (not applied): choose an assignment." Foreground="{DynamicResource ProjectLegionAccentBrush}" TextWrapping="Wrap" Margin="0,4,0,12" />
                    <WrapPanel>
                        <wpfui:Button x:Name="_applyButtonAssignment" Content="Apply assignment" Appearance="Primary" MinHeight="36" Margin="0,0,8,8" IsEnabled="False" Click="ApplyButtonAssignment_Click" />
                        <wpfui:Button x:Name="_restoreButtonAssignment" Content="Restore previous" MinHeight="36" Margin="0,0,0,8" IsEnabled="False" Click="RestoreButtonAssignment_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="_buttonStatus" Text="Read banks, then assignments. No values assumed." Style="{StaticResource ProjectLegionNoticeStyle}" AutomationProperties.LiveSetting="Polite" Margin="0,4,0,8" />
                    <TextBlock x:Name="_buttonRestoreInfo" Text="No restorable change in this session." Style="{StaticResource ProjectLegionTechnicalTextStyle}" />
                </StackPanel>
            </Border>
        </Grid>
        <TextBlock Text="Confirmed assignments" Style="{StaticResource MouseSection}" Margin="0,20,0,10" />
        <ItemsControl x:Name="_buttonLayout" AutomationProperties.Name="Confirmed mouse button assignments">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource MouseAssignmentRow}" Tag="{Binding Id}" Click="AssignmentRow_Click" Width="220" Padding="10" Margin="0,0,8,8" HorizontalContentAlignment="Stretch"
                    Background="#090A0C" BorderBrush="#252932" AutomationProperties.Name="{Binding Name}">
                    <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Assignment}" Style="{StaticResource ProjectLegionNoticeStyle}" Margin="0,4,0,0" /></StackPanel>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="_buttonLastConfirmed" Text="No confirmed assignment read yet." Style="{StaticResource ProjectLegionTechnicalTextStyle}" Margin="0,6,0,12" />
        <TextBlock Text="Bank browsing only inspects settings. Onboard save, switch and delete are unavailable until persistence is verified. No writes occur without an explicit Apply or Restore."
            Style="{StaticResource ProjectLegionTechnicalTextStyle}" />
    </StackPanel>
</wpfui:UiPage>
