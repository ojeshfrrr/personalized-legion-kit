<wpfui:UiPage
    x:Class="LenovoLegionToolkit.WPF.Pages.DonatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:utils="clr-namespace:LenovoLegionToolkit.WPF.Utils"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Credits &amp; legal"
    FlowDirection="{x:Static utils:LocalizationHelper.Direction}"
    Scrollable="True">

    <StackPanel Margin="0,0,16,12">
        <TextBlock Style="{StaticResource ProjectLegionPageTitleStyle}" Text="Credits &amp; legal" />
        <TextBlock Margin="0,0,0,8" FontSize="24" FontWeight="SemiBold" Text="Project Legion" />
        <TextBlock Style="{StaticResource ProjectLegionNoticeStyle}" Margin="0,0,0,20" Text="An unofficial independent derivative. It is not affiliated with or endorsed by Lenovo or the original maintainers." TextWrapping="Wrap" />

        <TextBlock Margin="0,0,0,8" Style="{StaticResource ProjectLegionSectionTitleStyle}" Text="Original project and attribution" />
        <TextBlock Margin="0,0,0,8" Text="This application reuses Lenovo Legion Toolkit source code by Bartosz Cichecki, Kaguya, and Dr. Skinner. Original copyright notices and third-party notices are retained in the source." TextWrapping="Wrap" />
        <wpfui:Hyperlink Click="OriginalSource_Click" Content="Original source project" Icon="Link24" />

        <TextBlock Margin="0,24,0,8" Style="{StaticResource ProjectLegionSectionTitleStyle}" Text="License" />
        <TextBlock Style="{StaticResource ProjectLegionNoticeStyle}" Text="The upstream project is licensed under GPL-3.0. This derivative remains subject to that license. See LICENSE and NOTICE in the application source." TextWrapping="Wrap" />
    </StackPanel>
</wpfui:UiPage>
